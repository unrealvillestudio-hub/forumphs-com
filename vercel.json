{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/blog", "destination": "/api/blog-index" },
    { "source": "/blog/:slug", "destination": "/api/blog-article?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/bim", "destination": "/api/bim" },
    { "source": "/bim/:token*", "destination": "/api/bim?token=:token*" }
  ],
  "headers": [
    {
      "source": "/blog",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/bim/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/assets/collateral/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
